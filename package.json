{
  "name": "contest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "setup": "npm ci --prefix web",
    "dev": "npm run dev --prefix web",
    "build": "npm ci --prefix web && npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "test": "npm run test --prefix web",
    "test:python": "python3 -m unittest discover -s tests",
    "collect:weekly": "python3 scripts/weekly_refresh.py"
  }
}
